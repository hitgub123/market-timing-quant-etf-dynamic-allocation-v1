{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "const": "tiingo_prestart_latency_evidence"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "compromise_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "credential_present": {
      "const": true
    },
    "credential_value_stored": {
      "const": false
    },
    "expected_session": {
      "const": "2026-10-12"
    },
    "fixture_status": {
      "const": "PRE_START_NONOFFICIAL_SOURCE_EVIDENCE"
    },
    "interruption_recorded": {
      "type": "boolean"
    },
    "observer_resumed_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "observer_started_at": {
      "format": "date-time",
      "type": "string"
    },
    "official_observation_created": {
      "const": false
    },
    "performance_calculated": {
      "const": false
    },
    "polls": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "enum": [
                    "VALID_SESSION",
                    "SESSION_UNAVAILABLE_OR_INVALID",
                    "INVALID_JSON"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "received_at",
                "http_status",
                "content_type",
                "raw_file",
                "raw_bytes",
                "raw_sha256",
                "raw_reconstruction",
                "row_count"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "TRANSPORT_ERROR"
                }
              }
            },
            "then": {
              "required": [
                "error_class"
              ]
            }
          }
        ],
        "properties": {
          "classification": {
            "enum": [
              "VALID_SESSION",
              "SESSION_UNAVAILABLE_OR_INVALID",
              "TRANSPORT_ERROR",
              "INVALID_JSON"
            ]
          },
          "content_type": {
            "type": "string"
          },
          "error_class": {
            "type": "string"
          },
          "http_status": {
            "type": "integer"
          },
          "poll": {
            "maximum": 2,
            "minimum": 1,
            "type": "integer"
          },
          "raw_bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "raw_file": {
            "pattern": "^poll_0[1-2]_(QQQ|QLD)\\.raw$",
            "type": "string"
          },
          "raw_reconstruction": {
            "type": "boolean"
          },
          "raw_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "received_at": {
            "format": "date-time",
            "type": "string"
          },
          "requested_at": {
            "format": "date-time",
            "type": "string"
          },
          "returned_last_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "row_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "safe_headers": {
            "additionalProperties": false,
            "properties": {
              "content-type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ratelimit-limit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ratelimit-remaining": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ratelimit-reset": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "x-ratelimit-limit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "x-ratelimit-remaining": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "x-ratelimit-reset": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "scheduled_at": {
            "format": "date-time",
            "type": "string"
          },
          "symbol": {
            "enum": [
              "QQQ",
              "QLD"
            ]
          }
        },
        "required": [
          "classification",
          "poll",
          "requested_at",
          "returned_last_date",
          "safe_headers",
          "scheduled_at",
          "symbol"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 0,
      "type": "array"
    },
    "raw_archive_outside_repository": {
      "const": true
    },
    "runner": {
      "const": "cron-single-poll"
    },
    "schedule_utc": {
      "const": [
        "2026-10-12T21:30:00Z",
        "2026-10-13T00:00:00Z"
      ]
    },
    "session_open_at": {
      "const": "2026-10-12T13:30:00Z"
    },
    "source_promoted": {
      "const": false
    },
    "status": {
      "enum": [
        "IN_PROGRESS",
        "OBSERVATION_COMPLETE",
        "OBSERVATION_COMPROMISED"
      ]
    },
    "symbols": {
      "const": [
        "QQQ",
        "QLD"
      ]
    },
    "total_request_budget": {
      "const": 4
    }
  },
  "required": [
    "artifact",
    "completed_at",
    "credential_present",
    "credential_value_stored",
    "expected_session",
    "fixture_status",
    "interruption_recorded",
    "observer_resumed_at",
    "observer_started_at",
    "official_observation_created",
    "performance_calculated",
    "polls",
    "raw_archive_outside_repository",
    "schedule_utc",
    "session_open_at",
    "source_promoted",
    "status",
    "symbols",
    "total_request_budget",
    "runner"
  ],
  "title": "Tiingo PRE_START nonofficial publication re-observation (2026-10-12, 4-request budget, cron-single-poll)",
  "type": "object"
}