{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/paper-trading/paper_observations.schema.json",
  "title": "paper_observations append-only record",
  "type": "object",
  "additionalProperties": false,
  "x-append-only": true,
  "x-primary-key": "observation_id",
  "x-timezone": "America/New_York plus canonical UTC timestamps",
  "x-source-snapshot": "sha256:<raw_hash> or SHA-256 of a sorted raw-hash manifest; vendor revision ID is optional",
  "required": [
    "observation_id",
    "schema_version",
    "protocol_version",
    "fixture_status",
    "source",
    "source_raw_hash",
    "session_date",
    "symbol",
    "exchange_open_at",
    "exchange_close_at",
    "signal_close_at",
    "data_available_at",
    "data_acquired_at",
    "raw_close",
    "adjusted_close",
    "ma200",
    "signal",
    "target_state",
    "weekly_scheduled",
    "monthly_scheduled",
    "bimonthly_scheduled",
    "quarterly_scheduled",
    "source_snapshot_id",
    "source_revision_id",
    "calendar_version",
    "code_commit",
    "created_at",
    "previous_record_hash",
    "record_hash",
    "batch_id",
    "chain_scope",
    "chain_sequence"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string"
    },
    "fixture_status": {
      "type": "string",
      "enum": [
        "SYNTHETIC_TEST_FIXTURE",
        "OFFICIAL_PROSPECTIVE"
      ]
    },
    "source": {
      "type": "string"
    },
    "source_raw_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "session_date": {
      "type": "string",
      "format": "date"
    },
    "symbol": {
      "type": "string",
      "enum": [
        "QQQ",
        "QLD"
      ]
    },
    "exchange_open_at": {
      "type": "string",
      "format": "date-time"
    },
    "exchange_close_at": {
      "type": "string",
      "format": "date-time"
    },
    "signal_close_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_available_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "data_acquired_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "raw_close": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "x-units": "USD/share"
    },
    "adjusted_close": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "x-units": "USD/share"
    },
    "ma200": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "x-units": "USD/share"
    },
    "signal": {
      "type": [
        "number",
        "null"
      ],
      "enum": [
        0,
        1,
        null
      ]
    },
    "target_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "QLD",
        "CASH",
        null
      ]
    },
    "weekly_scheduled": {
      "type": "boolean"
    },
    "monthly_scheduled": {
      "type": "boolean"
    },
    "bimonthly_scheduled": {
      "type": "boolean"
    },
    "quarterly_scheduled": {
      "type": "boolean"
    },
    "source_revision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "calendar_version": {
      "type": "string"
    },
    "code_commit": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "previous_record_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "chain_scope": {
      "type": "string",
      "minLength": 1
    },
    "chain_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "source_snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "x-chain-scope": "paper_observations/protocol_version",
  "x-chain-ordering": [
    "canonical_event_time_utc",
    "primary_key",
    "created_at",
    "chain_sequence"
  ],
  "x-genesis": {
    "first_record_previous_record_hash": null,
    "chain_sequence": 0
  },
  "x-corrections": "Corrections/revisions append records in their own ledger chain and never overwrite the original."
}
