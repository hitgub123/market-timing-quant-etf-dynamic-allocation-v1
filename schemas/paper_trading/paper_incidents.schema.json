{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/paper-trading/paper_incidents.schema.json",
  "title": "paper_incidents deterministic incident record",
  "type": "object",
  "additionalProperties": false,
  "x-append-only": true,
  "x-primary-key": "incident_id",
  "required": ["incident_id", "schema_version", "protocol_version", "fixture_status", "incident_code", "category", "severity", "trigger", "incident_at", "session_date", "source", "affected_record_ids", "raw_evidence_hashes", "automatic_action", "operator_action", "resolution", "protocol_validity_effect", "restart_required", "created_at", "previous_record_hash", "record_hash"],
  "properties": {
    "incident_id": {"type": "string"},
    "schema_version": {"type": "string"},
    "protocol_version": {"type": "string"},
    "fixture_status": {"type": "string", "enum": ["SYNTHETIC_TEST_FIXTURE", "OFFICIAL_PROSPECTIVE"]},
    "incident_code": {"type": "string"},
    "category": {"type": "string"},
    "severity": {"type": "string", "enum": ["INFO", "WARNING", "RECOVERABLE", "MATERIAL", "PROTOCOL_INVALIDATING"]},
    "trigger": {"type": "string"},
    "incident_at": {"type": "string", "format": "date-time"},
    "session_date": {"type": ["string", "null"], "format": "date"},
    "source": {"type": "string"},
    "affected_record_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "raw_evidence_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "uniqueItems": true},
    "automatic_action": {"type": "string"},
    "operator_action": {"type": "string"},
    "resolution": {"type": ["string", "null"]},
    "protocol_validity_effect": {"type": "string", "enum": ["NONE", "PAUSE_AFFECTED_RECORD", "RECONSTRUCT_REQUIRED", "PROTOCOL_INVALID"]},
    "restart_required": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "previous_record_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
